{
  "name": "@beeard/agent-init",
  "version": "0.1.2",
  "description": "Scaffold an agent-operating structure into any repository: standing orders, decision records, skills, and the gates that enforce them.",
  "type": "module",
  "bin": {
    "agent-init": "src/cli.mjs"
  },
  "exports": {
    ".": "./src/plan.mjs",
    "./apply": "./src/apply.mjs"
  },
  "files": [
    "src",
    "skills",
    "templates",
    "LICENSE",
    "README.md",
    "AGENTS.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beeard/agent-init.git"
  },
  "homepage": "https://github.com/beeard/agent-init#readme",
  "bugs": {
    "url": "https://github.com/beeard/agent-init/issues"
  },
  "author": "Tom Steinar Thorsen <tomsteinar@gmail.com>",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "format": "npx --yes prettier@$npm_package_config_prettier --write \"**/*.{mjs,js,cjs,yml,yaml}\"",
    "format:check": "npx --yes prettier@$npm_package_config_prettier --check \"**/*.{mjs,js,cjs,yml,yaml}\"",
    "prepublishOnly": "node scripts/prepublish.mjs"
  },
  "config": {
    "prettier": "3.8.1"
  },
  "keywords": [
    "agents",
    "agents.md",
    "adr",
    "scaffold",
    "decision-records"
  ],
  "license": "MIT"
}
