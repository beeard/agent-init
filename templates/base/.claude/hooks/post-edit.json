{
  "checks": {
    "javascript-syntax": {
      "extensions": [".js", ".mjs", ".cjs"],
      "run": ["{node}", "--check", "{file}"]
    },
    "json-syntax": {
      "extensions": [".json"],
      "exclude": ["tsconfig*.json", "jsconfig*.json", ".vscode/*", ".devcontainer/*", "devcontainer.json"],
      "run": ["{node}", "-e", "try { JSON.parse(require('node:fs').readFileSync(process.argv[1], 'utf8')) } catch (error) { console.error(error.message); process.exit(1) }", "{file}"]
    },
    "prettier": {
      "extensions": ["*"],
      "optional": true,
      "run": [["node_modules/.bin/prettier", "node_modules/.bin/prettier.cmd"], "--write", "--ignore-unknown", "--log-level", "warn", "{file}"]
    }
  }
}
